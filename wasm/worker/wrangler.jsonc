{
  // Experimental: OpenBao core on Cloudflare Workers. See wasm/README.md.
  "name": "openbao-worker",
  "main": "./build/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // No custom build: produce ./build with wasm/harness/build.sh (or npm run build)
  // before 'wrangler dev' / 'wrangler deploy'. A build command here would be
  // re-run on every dev start and silently replace the bundle.
  // Paid plan only: OpenBao's unseal + request handling needs more than the
  // free plan's 10 ms of CPU per request.
  "limits": { "cpu_ms": 30000 },
  "dev": { "port": 8787, "local_protocol": "http" },
  "durable_objects": {
    "bindings": [{ "name": "OPENBAO", "class_name": "OpenBaoCore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OpenBaoCore"] }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // wrangler hyperdrive create openbao --connection-string="postgres://..."
      "id": "00000000000000000000000000000000",
      // 'wrangler dev' talks to this database instead of Hyperdrive
      "localConnectionString": "postgres://bao:bao@127.0.0.1:5432/bao?sslmode=disable"
    }
  ],
  "vars": {
    "BAO_LOG_LEVEL": "info",
    "BAO_API_ADDR": "https://openbao-worker.<account>.workers.dev"
  }
  // Secrets (wrangler secret put):
  //   BAO_STATIC_SEAL_CURRENT_KEY     32-byte key, hex or base64
  //   BAO_STATIC_SEAL_CURRENT_KEY_ID  any identifier, e.g. "v1"
}
